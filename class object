public class Main {
    public static void main(String[] args) {
        TN a = new TN();
        AN a1 = new AN();
        a.set_dim("Vijay", "Chennai", 8091092, common.PM);
        a1.set_dim("Chandrababu", "Vijayawada", 9876644, common.PM);
        a.display();
        a1.display();
    }
}
