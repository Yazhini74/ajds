class common {
    static String PM = "Narendra Modi";
}

class TN {
    static String state = "TamilNadu";
    String PM;
    String CM;
    String District;
    int pop;

    public void set_dim(String c, String d, int cpop, String p) {
        CM = c;
        District = d; 
        pop = cpop;
        PM = p;
    }

    public void display() {
        System.out.println("1.PM:" + PM);
        System.out.println("2.CM:" + CM);
        System.out.println("3.State:" + state);
        System.out.println("4.District name:" + District);
        System.out.println("5.Population:" + pop);
    }
}

class AN {
    static String state = "Andhra Pradesh";
    String PM;
    String CM;
    String District; 
